NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to send the job portal apply-flow email verification codes
# (see app/api/leads/request-code). Requires a verified sending domain
# in Resend for the `from` address used in lib/resend.ts.
RESEND_API_KEY=

# LeadsMind CRM sync (lib/leadsmind.ts, docs/leadsmind-sync.md). Every
# verified job-portal lead is submitted to this LeadsMind form. All optional:
# the defaults are the World Teachers Academy form
# 762edbd4-3d18-47c3-8d54-3c9209edf650 and its First/Last Name + Email fields.
LEADSMIND_DISABLED=
LEADSMIND_BASE_URL=
LEADSMIND_FORM_ID=
LEADSMIND_WORKSPACE_ID=
# JSON {"firstName":"<field id>","lastName":"<field id>","email":"<field id>"}
LEADSMIND_FIELD_MAP=
LEADSMIND_MAX_ATTEMPTS=
# Required for the retry job (/api/cron/leadsmind-retry). Long random string.
CRON_SECRET=
# Optional safety net: ISO date; leads verified since then with no queue row
# are queued by the retry job (never more than 2 days back).
LEADSMIND_SYNC_START=
